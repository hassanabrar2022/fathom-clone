+/* The account entry follows the selected public palette on both halves. */
+html:not([data-theme='dark']) #root .auth-page {
+  --auth-canvas: #f6f4ef;
+  --auth-surface: #fffdf9;
+  --auth-ink: #25221e;
+  --auth-muted: #625d55;
+  --auth-line: #d8d2c8;
+  --auth-accent: #ae4728;
+  --auth-accent-soft: #f6e4d8;
+}
+html:not([data-theme='dark']) #root .auth-story {
+  color: #25221e;
+  background: #eeeae3;
+  border-right-color: #d8d2c8;
+}
+html:not([data-theme='dark']) #root .auth-story::after {
+  opacity: 0.08;
+}
+html:not([data-theme='dark']) #root .auth-brand {
+  color: #25221e;
+}
+html:not([data-theme='dark']) #root .auth-brand > span {
+  background: #ae4728;
+  color: #fffdf9;
+}
+html:not([data-theme='dark']) #root .auth-brand sup,
+html:not([data-theme='dark']) #root .auth-story .auth-eyebrow,
+html:not([data-theme='dark']) #root .auth-story h2 em {
+  color: #ae4728;
+}
+html:not([data-theme='dark']) #root .auth-story h2 {
+  color: #25221e;
+}
+html:not([data-theme='dark']) #root .auth-story-content > p,
+html:not([data-theme='dark']) #root .auth-story-footer {
+  color: #625d55;
+}
+html:not([data-theme='dark']) #root .auth-page .auth-story-art {
+  color: #25221e;
+  background: #fffdf9;
+  border-color: #d8d2c8;
+}
+html:not([data-theme='dark']) #root .auth-story-art > div:first-child span {
+  color: #ae4728;
+}
+html:not([data-theme='dark'])
+  #root
+  .auth-page
+  .auth-story-art
+  > div:last-child {
+  color: #8e3f26;
+  background: #f6e4d8;
+  border-color: #d5b19d;
+}
+html:not([data-theme='dark']) #root .auth-page .auth-story-art > i {
+  background: linear-gradient(90deg, #ae4728 0 60%, #d8d2c8 60%);
+}
+
+/* Carry the landing page's black stage through both account screens. */
+html[data-theme='dark'] #root .auth-page {
+  --auth-canvas: #050505;
+  --auth-surface: #101010;
+  --auth-ink: #f5f3ef;
+  --auth-muted: #b9b5ae;
+  --auth-line: #292929;
+  --auth-accent: #ed8b63;
+  --auth-accent-soft: #2d1d17;
+  background: var(--auth-canvas);
+}
+html[data-theme='dark'] #root .auth-page .auth-story {
+  background: #080808;
+  border-right-color: var(--auth-line);
+}
+html[data-theme='dark'] #root .auth-page .auth-main {
+  background: var(--auth-canvas);
+}
+html[data-theme='dark'] #root .auth-page .auth-field input {
+  background: var(--auth-surface);
+  border-color: var(--auth-line);
+}
+html[data-theme='dark'] #root .auth-page .auth-field input::placeholder {
+  color: #89847d;
+}
+html[data-theme='dark'] #root .auth-page .auth-story-art {
+  background: #101010;
+  border-color: #342b26;
+}
+html[data-theme='dark'] #root .auth-page .auth-story-art > div:last-child {
+  background: #211713;
+  border-color: #5a392c;
+}
+html[data-theme='dark'] .auth-loading,
+html[data-theme='dark'] body:has(.auth-loading) {
+  background: #050505;
+}
diff --git a/apps/web/src/data/transcription-audio.ts b/apps/web/src/data/transcription-audio.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9baa608fee6ee945a7433ef6abdb6a43c3fb0da0
--- /dev/null
+++ b/apps/web/src/data/transcription-audio.ts
@@ -0,0 +1,57 @@
+// Long recordings are sent to transcription as audio, not as an entire video.
+// This PCM file is uploaded privately alongside the original playback media.
+export const longRecordingSeconds = 120;
+const sampleRate = 16000;
+
+export async function transcriptionAudio(file: File): Promise<Blob> {
+  const decoder = new AudioContext();
+  let decoded: AudioBuffer;
+  try {
+    decoded = await decoder.decodeAudioData(await file.arrayBuffer());
+  } catch {
+    throw new Error(
+      'This browser could not prepare the recording audio. Try an MP4, WebM, MP3, or WAV file.',
+    );
+  } finally {
+    await decoder.close();
+  }
+  const offline = new OfflineAudioContext(
+    1,
+    Math.ceil(decoded.duration * sampleRate),
+    sampleRate,
+  );
+  const source = offline.createBufferSource();
+  source.buffer = decoded;
+  source.connect(offline.destination);
+  source.start();
+  const rendered = await offline.startRendering();
+  const samples = rendered.getChannelData(0);
+  const buffer = new ArrayBuffer(44 + samples.length * 2);
+  const view = new DataView(buffer);
+  const label = (offset: number, value: string) => {
+    for (let index = 0; index < value.length; index++)
+      view.setUint8(offset + index, value.charCodeAt(index));
+  };
+  label(0, 'RIFF');
+  view.setUint32(4, buffer.byteLength - 8, true);
+  label(8, 'WAVE');
+  label(12, 'fmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, 1, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * 2, true);
+  view.setUint16(32, 2, true);
+  view.setUint16(34, 16, true);
+  label(36, 'data');
+  view.setUint32(40, samples.length * 2, true);
+  for (let index = 0; index < samples.length; index++) {
+    const sample = Math.max(-1, Math.min(1, samples[index]));
+    view.setInt16(
+      44 + index * 2,
+      sample < 0 ? Math.round(sample * 32768) : Math.round(sample * 32767),
+      true,
+    );
+  }
+  return new Blob([buffer], { type: 'audio/wav' });
+}
diff --git a/apps/web/src/editorial.css b/apps/web/src/editorial.css
new file mode 100644
index 0000000000000000000000000000000000000000..c4d2805e34b2a0f8d8da9072d2c320b2da8caa05
--- /dev/null
+++ b/apps/web/src/editorial.css
@@ -0,0 +1,780 @@
+/* Fathom Clone editorial system. Adapted from the supplied reference's visual principles;
+   no Framer runtime, artwork, copy, or application logic is imported. */
+@font-face {
+  font-family: 'Schibsted Grotesk';
+  src: url('/fonts/schibsted-regular.woff2') format('woff2');
+  font-weight: 400 600;
+  font-display: swap;
+}
+@font-face {
+  font-family: 'Schibsted Grotesk';
+  src: url('/fonts/schibsted-bold.woff2') format('woff2');
+  font-weight: 700 900;
+  font-display: swap;
+}
+@font-face {
+  font-family: 'Fragment Mono';
+  src: url('/fonts/fragment-mono.woff2') format('woff2');
+  font-display: swap;
+}
+:root {
+  font-family: 'Schibsted Grotesk', Inter, sans-serif;
+  --editorial-mono: 'Fragment Mono', ui-monospace, monospace;
+  --editorial-rule: 1px solid var(--border);
+  --editorial-ease: cubic-bezier(.22, 1, .36, 1);
+}
+html { scroll-behavior: smooth; }
+body { background: var(--page-background); }
+#root :is(button, input, select, textarea) { font-family: inherit; }
+#root :is(.eyebrow, .small-label, .workspace-label, .feature-kicker, .breadcrumb, .demo-badge, .list-header, .source-badge, .summary-kicker, .transcript-source, .recording-ready, .upload-footnote) {
+  font-family: var(--editorial-mono);
+  letter-spacing: .055em;
+}
+#root :is(.primary-button, .secondary-button, .nav-link, .meeting-row, .filter, .source-button, .transport-button, .template-switcher button) {
+  transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms var(--editorial-ease);
+}
+#root :is(.primary-button, .secondary-button):active { transform: translateY(1px); }
+#root :where(.app-shell, .auth-page, .marketing-page) :is(a,button,input,select,textarea,summary):focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 3px;
+}
+/* Public story: generous editorial type, measured rules, and a single signal color. */
+#root .marketing-page {
+  --m-canvas: #f6f4ef;
+  --m-paper: #fcfaf6;
+  --m-surface: #fffdf9;
+  --m-soft: #ece8e0;
+  --m-deep: #1b1b19;
+  --m-ink: #242320;
+  --m-muted: #605d56;
+  --m-faint: #77736a;
+  --m-line: #d9d4ca;
+  --m-accent: #b54828;
+  --m-accent-soft: #fae9df;
+  --m-accent-ink: #94391f;
+  --m-shadow: 0 24px 60px rgba(20, 17, 14, .07);
+  font-family: 'Schibsted Grotesk', Inter, sans-serif;
+  background: var(--m-canvas);
+}
+html[data-theme='dark'] #root .marketing-page {
+  --m-canvas: #191919;
+  --m-paper: #21211f;
+  --m-surface: #292825;
+  --m-soft: #1f1f1d;
+  --m-deep: #141413;
+  --m-ink: #f5f2eb;
+  --m-muted: #c5bfb5;
+  --m-faint: #a69f94;
+  --m-line: #3c3a36;
+  --m-accent: #ff986d;
+  --m-accent-soft: #422c24;
+  --m-accent-ink: #ffad86;
+  --m-shadow: 0 26px 65px rgba(0,0,0,.12);
+}
+#root .marketing-container { width: min(calc(100% - 72px), 1320px); }
+#root .marketing-page :is(.marketing-eyebrow, .hero-index, .capability-strip, .art-topline, .art-foot, .transform-stage-top, .transform-stage-bottom, .summary-kicker, .search-demo kbd, .steps-number, .footer-bottom, .close-trail) {
+  font-family: var(--editorial-mono);
+  letter-spacing: .055em;
+}
+#root .marketing-eyebrow { color: var(--m-accent-ink); font-size: 11px; font-weight: 400; }
+#root .marketing-eyebrow i { border-radius: 1px; box-shadow: none; width: 8px; height: 8px; }
+#root .marketing-page h1, #root .marketing-page h2, #root .marketing-page h3 {
+  font-family: 'Schibsted Grotesk', Inter, sans-serif;
+  font-weight: 700;
+  letter-spacing: -.06em;
+}
+#root .marketing-page h2 { line-height: 1.07; }
+#root .marketing-page em { color: var(--m-accent); }
+#root .marketing-page .marketing-nav {
+  height: 78px;
+  border-bottom: 1px solid var(--m-line);
+  background: color-mix(in srgb, var(--m-canvas) 94%, transparent);
+  backdrop-filter: blur(12px);
+}
+#root .marketing-page .marketing-nav.is-scrolled { height: 66px; }
+#root .marketing-nav-inner { gap: clamp(28px, 4vw, 64px); }
+#root .marketing-brand { font-size: 25px; letter-spacing: -.07em; }
+#root .marketing-brand-mark { width: 36px; height: 36px; border-radius: 2px; background: var(--m-accent); color: #fffdf9; }
+#root .marketing-brand sup { color: var(--m-accent-ink); font-family: var(--editorial-mono); font-size: 9px; }
+#root .marketing-nav-links a, #root .marketing-nav-actions > a:not(.marketing-button) {
+  color: var(--m-muted); font-size: 12px; font-weight: 600;
+}
+#root .marketing-nav-links a:hover, #root .marketing-nav-actions > a:not(.marketing-button):hover { color: var(--m-accent); }
+#root .marketing-button { border-radius: 3px; min-height: 43px; padding-inline: 20px; font-size: 12px; letter-spacing: .015em; }
+#root .marketing-button.large { min-height: 52px; padding-inline: 24px; }
+#root .marketing-page .marketing-button.primary { background: var(--m-ink); color: var(--m-canvas); }
+#root .marketing-page .marketing-button.primary:hover { background: var(--m-accent); color: #fff; }
+#root .marketing-page .marketing-button.subtle { border-color: var(--m-line); background: transparent; color: var(--m-ink); }
+#root .marketing-page .marketing-button.subtle:hover { border-color: var(--m-accent); background: var(--m-accent-soft); color: var(--m-ink); }
+#root .marketing-page .marketing-hero {
+  position: relative; padding: clamp(68px, 8vw, 128px) 0 28px;
+  background: var(--m-canvas);
+}
+#root .marketing-hero::before {
+  background: radial-gradient(ellipse 38% 48% at 86% 28%, color-mix(in srgb, var(--m-accent) 12%, transparent), transparent 75%);
+  pointer-events: none;
+}
+#root .hero-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(36px, 5vw, 88px); }
+#root .marketing-hero-copy { padding-bottom: 16px; }
+#root .marketing-hero h1 { max-width: 690px; font-size: clamp(58px, 5.8vw, 98px); line-height: .99; }
+#root .marketing-hero h1 em { color: var(--m-accent); }
+#root .marketing-hero-copy > p { max-width: 520px; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.62; }
+#root .hero-note { font-family: var(--editorial-mono); font-size: 10px; color: var(--m-faint); }
+#root .hero-note-line { background: var(--m-accent); }
+#root .hero-art {
+  border-radius: 3px; border-color: var(--m-line);
+  box-shadow: 16px 16px 0 color-mix(in srgb, var(--m-accent) 9%, transparent), var(--m-shadow);
+  animation: editorial-arrive 700ms 180ms var(--editorial-ease) both;
+}
+#root .hero-art::before { opacity: .3; }
+#root .art-topline, #root .art-foot { border-color: var(--m-line); }
+#root .art-live-dot { background: var(--m-accent); }
+#root .art-transcript, #root .art-intelligence { border-radius: 2px; }
+#root .art-transcript { border-left: 2px solid var(--m-accent); }
+#root .art-intelligence strong { color: var(--m-accent-ink); }
+#root .hero-index { border-top: 1px solid var(--m-line); padding-top: 18px; }
+#root .capability-strip { border-block: 1px solid var(--m-line); background: var(--m-paper); }
+#root .capability-strip .marketing-container { min-height: 72px; }
+#root .capability-strip span { color: var(--m-muted); font-size: 10px; }
+#root .marketing-section { position: relative; padding: clamp(90px, 9vw, 150px) 0; border-bottom: 1px solid var(--m-line); }
+#root .opening-section { background: var(--m-deep); color: #f4f0e9; }
+#root .opening-section .marketing-eyebrow { color: #ffae86; }
+#root .opening-section h2 { font-size: clamp(68px, 7.8vw, 124px); line-height: .95; }
+#root .opening-copy > p:first-child { color: #f3ede4; }
+#root .opening-copy > p:last-child, #root .opening-thread span { color: #b9b2a8; }
+#root .opening-thread { border-color: #4b453e; }
+#root .opening-thread strong { color: #ffae86; }
+#root .transformation { background: var(--m-canvas); }
+#root .transform-grid { grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(40px, 7vw, 115px); }
+#root .transform-steps button { padding: 26px 20px; border-left-width: 3px; }
+#root .transform-steps button.is-active { border-left-color: var(--m-accent); }
+#root .transform-steps strong { font-size: 21px; }
