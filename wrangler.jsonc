{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fathom-clone",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-14",
  // The built web app. API routes reach the Worker first; every other path is
  // a static asset or falls back to index.html for client-side routing.
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "fathom-clone-process-meeting",
      "binding": "PROCESS_MEETING",
      "class_name": "ProcessMeetingWorkflow"
    },
    {
      "name": "fathom-clone-capture-meeting",
      "binding": "CAPTURE_MEETING",
      "class_name": "CaptureMeetingWorkflow"
    }
  ],
  // Sends notetakers to upcoming meetings on calendars with auto-record on.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Per-address limits on sign-in/sign-up/reset, per-account limits on changes.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
