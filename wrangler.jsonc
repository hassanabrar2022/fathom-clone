{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fathom-clone",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-14",
  // The built web app. API routes reach the Worker first; every other path is
  // a static asset or falls back to index.html for client-side routing.
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "fathom-clone-process-meeting",
      "binding": "PROCESS_MEETING",
      "class_name": "ProcessMeetingWorkflow"
    }
  ],
  "observability": { "enabled": true }
}
