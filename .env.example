# Server-side deployment configuration only. Supply values locally, never in chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Checkpoint F server-only configuration. Place actual values in ignored .dev.vars.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase auth API key, consumed by the Worker; never expose the service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Migration administration only; never deploy this value to the worker.
SUPABASE_DB_URL=
# Optional IPv4 session-pooler URL for share-link migrations where direct DB IPv6 is unavailable.
SUPABASE_POOLER_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
